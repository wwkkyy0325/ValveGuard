{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ValveGuard",
  "version": "1.0.1",
  "identifier": "com.valveguard.review",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:47183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ValveGuard · 对局复核",
        "width": 1440,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "dragDropEnabled": true,
        "alwaysOnTop": false,
        "theme": "Dark",
        "backgroundColor": "#0a0f18"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../artifacts/valveguard_cnn_v1_onnx/model.onnx": "model/model.onnx",
      "../../artifacts/valveguard_cnn_v1_onnx/manifest.json": "model/manifest.json",
      "../../artifacts/valveguard_cnn_v1_onnx/channel_names.json": "model/channel_names.json",
      "../../artifacts/valveguard_cnn_v1_onnx/human_player_scores.json": "model/human_player_scores.json",
      "../../artifacts/valveguard_cnn_v1_onnx/reference.npz": "model/reference.npz",
      "../../artifacts/valveguard_cnn_v1_onnx/reference.json": "model/reference.json"
    },
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
